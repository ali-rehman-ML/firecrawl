# Firecrawl on a small host (2 vCPU / 2 GB), for docker-compose.lite.yaml.
#
#   cp .env.lite.example .env.lite
#   docker compose --env-file .env.lite -f docker-compose.lite.yaml up -d
#
# Keep it in .env.lite and pass --env-file: the root .env belongs to
# docker-compose.yaml, and these settings would break that stack.
#
# Every value below is the default baked into docker-compose.lite.yaml; the
# file is here so you can see and move the knobs, not because it is required.

# --- API ------------------------------------------------------------------
# Host port the API listens on. The API is unauthenticated: keep it bound to a
# trusted network, or put authentication and TLS in front of it.
PORT=3002
USE_DB_AUTHENTICATION=false

# --- Capacity -------------------------------------------------------------
# Concurrent scrapes. Each NuQ worker is a Node process handling one job at a
# time, so this is both the concurrency and the largest memory lever in the
# API container. 2 is usually the ceiling on 2 GB, and only with swap.
#
# Client concurrency should track this number. /v1/scrape is synchronous with a
# 30 s default timeout, so requests beyond NUQ_WORKER_COUNT queue and the tail
# of a large parallel batch times out with 408 even though nothing is wrong.
# Measured, 10 URLs against one worker: `xargs -P5` -> 9x200 + 1x408;
# `xargs -P2` -> 10x200. For big lists use /v1/batch/scrape, which queues
# server-side instead of holding a connection per URL.
NUQ_WORKER_COUNT=1

# Which harness processes to run. Each is a Node process costing 120-260 MB
# resident (measured on a 2 vCPU box), so this is the main memory lever.
#   api        serves HTTP and enqueues jobs      ~245 MB
#   worker     finishes crawls, non-scrape queues ~120 MB
#   nuq-worker performs the scrapes               ~260 MB each
# Add ",nuq-reconciler-worker" (~250 MB, raise API_MEM_LIMIT with it) to
# recover jobs stranded in the concurrency backlog. Drop to "api,nuq-worker"
# for a scrape-only stack with no crawl completion.
HARNESS_SERVICES=api,worker,nuq-worker

# Fallback heap ceiling for any process not named in HARNESS_HEAP_MB.
NODE_OPTIONS=--max-old-space-size=256

# Per-process heap ceilings, in MB. These are deliberately unequal: the api
# process holds every in-flight HTTP request, so client concurrency lands on
# its heap, while the queue worker is nearly idle. Sizing them equally is what
# made five concurrent /v1/scrape calls kill the stack -- api aborted with
# "FATAL ERROR: Reached heap limit", the harness treats a dead child as fatal,
# and every connection was refused until Docker restarted the container.
#
# 256 MB is a hard floor -- every process loads the same dependency tree before
# doing any work, and 128 MB aborted the queue worker 9.8 s into startup, which
# the harness turns into a container restart loop. It now refuses to start.
#
# Budget: sum of heaps + ~70 MB non-heap per process + ~50 MB harness must fit
# inside API_MEM_LIMIT. Raise api= first if you serve more concurrent clients.
HARNESS_HEAP_MB=api=448,worker=256,nuq-worker=288

# Postgres connections per harness process. max_connections must stay above
# (number of harness processes x this) plus headroom.
NUQ_POOL_MAX=4

# Concurrent native PDF extractions per process; each holds the PDF and its
# parsed text in memory, largely off the V8 heap.
PDF_EXTRACTION_CONCURRENCY=1

# Load-shedding thresholds for the queue worker. Below these it takes jobs;
# above them it refuses, and crawls stop reaching "completed" because the
# crawl-finish worker is the thing being refused. The 0.8 defaults assume a
# host with spare capacity -- this stack is sized to fill a small one, so they
# trip permanently. Concurrency is already capped at one job by
# NUQ_WORKER_COUNT, so there is little left for shedding to protect. Lower
# them if the box is shared with something you care about more.
MAX_RAM=0.95
MAX_CPU=0.95

# --- Browser --------------------------------------------------------------
# Concurrent Chromium pages. Keep at or below NUQ_WORKER_COUNT: extra pages
# cost ~80-150 MB each and nothing is there to use them.
MAX_CONCURRENT_PAGES=1
# Discard images/media during rendering. Off by default: blocking media makes
# the page's `load` event fire earlier, and the Playwright service reads the
# page on `load`, so it can win the race against client-side hydration and
# return a near-empty 200. Measured on a JS-hydrated SPA, cold browser cache:
#   BLOCK_MEDIA=True  -> 46 chars on the first scrape, 7378 after
#   BLOCK_MEDIA=False -> 7378 every time
# Set True only for static pages where you want the bandwidth back.
BLOCK_MEDIA=False

# To run without a browser at all (fetch-only: no JS rendering, screenshots or
# actions, ~600 MB freed), comment out the playwright-service block in
# docker-compose.lite.yaml and uncomment the next line. The empty value is
# what disables the engine, so it must stay empty rather than be removed.
# PLAYWRIGHT_MICROSERVICE_URL=

# --- Container memory limits ----------------------------------------------
# Measured steady state after scrape + JS render + PDF + an 8-page crawl:
# playwright ~275-310 MB, postgres ~97 MB, redis ~13 MB. Those three get their
# measurement plus headroom; the API container gets the rest of the box, since
# its Node heaps expand to whatever they are allowed (it will read as ~100%
# full -- that is expected; an OOM kill is the real signal). ~1.4 GB in use
# against these ~1.7 GB of limits, so configure swap (see SELF_HOST.md) rather
# than treating the remainder as comfortable. For genuine headroom use
# HARNESS_SERVICES=api,nuq-worker with API_MEM_LIMIT=768m: 664 MB used, and
# ~1.05 GB across the whole stack.
API_MEM_LIMIT=1280m
PLAYWRIGHT_MEM_LIMIT=448m
POSTGRES_MEM_LIMIT=160m
REDIS_MEM_LIMIT=64m

# --- Datastores -----------------------------------------------------------
POSTGRES_MAX_CONNECTIONS=30
POSTGRES_SHARED_BUFFERS=48MB
REDIS_MAXMEMORY=48mb

# --- Images ---------------------------------------------------------------
# The API image must be built from this revision: HARNESS_SERVICES lives in the
# harness, not in Compose. Leaving FIRECRAWL_IMAGE unset means the first `up`
# builds it locally (tens of minutes on 2 vCPUs; give the box swap). To pull a
# prebuilt one instead, set it to your registry tag and use
# `compose pull && compose up -d --no-build`, so a missing tag errors rather
# than silently starting a build. Architecture must match the host: t3.small is
# x86_64, so build with --platform linux/amd64 if you build on ARM.
# Playwright and NuQ PostgreSQL are unmodified upstream images; pin to a tag.
# FIRECRAWL_IMAGE=<account>.dkr.ecr.<region>.amazonaws.com/firecrawl-api:lite
# PLAYWRIGHT_IMAGE=ghcr.io/firecrawl/playwright-service:latest
# NUQ_POSTGRES_IMAGE=ghcr.io/firecrawl/nuq-postgres:latest

# --- Optional -------------------------------------------------------------
# PROXY_SERVER=
# PROXY_USERNAME=
# PROXY_PASSWORD=
# SEARXNG_ENDPOINT=
# LOGGING_LEVEL=info
